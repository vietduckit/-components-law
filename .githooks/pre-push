#!/usr/bin/env bash
# Runs before every `git push`:
#   1. If this clone has `git config hooks.blockPush true`, refuse ALL pushes
#      (turn off with: git config --unset hooks.blockPush).
#   2. Otherwise scan every commit about to be pushed — not just the latest
#      one — and refuse if any of them adds credentials (see secret-scan.sh).
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ZERO=0000000000000000000000000000000000000000

if [ "$(git config --bool hooks.blockPush)" = "true" ]; then
  echo "✖ pre-push: pushing is disabled in this clone (git config hooks.blockPush true)." >&2
  echo "  Enable again with: git config --unset hooks.blockPush" >&2
  exit 1
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue # deleting a remote branch
  if [ "$remote_sha" = "$ZERO" ]; then
    range=$(git rev-list "$local_sha" --not --remotes)
  else
    range=$(git rev-list "$remote_sha..$local_sha")
  fi
  [ -z "$range" ] && continue
  count=$(echo "$range" | wc -l | tr -d ' ')
  echo "$range" \
    | xargs git show --no-color -U0 --format= --diff-filter=ACMR \
    | bash "$HOOK_DIR/secret-scan.sh" "$count commit(s) being pushed to $remote_ref" \
    || status=1
done
exit $status
